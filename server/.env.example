# Copy this file to .env and fill in your real values.
DATABASE_URL=postgresql://username:password@your-database-host:5432/scholarpro
JWT_SECRET=change-this-in-production
CORS_ORIGIN=http://localhost:5173

# ZetuPay keys (backend secret stays on server only)
ZETUPAY_PUBLIC_KEY=pk_test_your_public_key_here
ZETUPAY_SECRET_KEY=sk_test_your_secret_key_here
ZETUPAY_WEBHOOK_SECRET=your_webhook_secret_here
ZETUPAY_ENV=sandbox
ZETUPAY_BASE_URL=https://pay.zetupay.co.ke
ZETUPAY_REDIRECT_URL=http://localhost:5173/payment/success
